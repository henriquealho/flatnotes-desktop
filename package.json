{
  "name": "flatnotes-desktop",
  "productName": "flatnotes",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "A sleek Electron-based desktop client for flatnotes. Your notes, your file system, now in a dedicated app.",
  "main": "main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite",
    "electron": "electron .",
    "electron-dev": "set NODE_ENV=development && npm run build && electron .",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "author": "Henrique Alho",
  "license": "MIT",
  "dependencies": {
    "@jamescoyle/vue-icon": "0.1.2",
    "@mdi/js": "7.4.47",
    "@mdi/light-js": "0.2.63",
    "@toast-ui/editor": "3.2.2",
    "@toast-ui/editor-plugin-code-syntax-highlight": "3.1.0",
    "axios": "1.12.2",
    "electron-squirrel-startup": "^1.0.1",
    "lunr": "^2.3.9",
    "mousetrap": "1.6.5",
    "pinia": "3.0.3",
    "primevue": "3.53.1",
    "vue": "3.5.22",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
