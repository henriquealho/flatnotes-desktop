    "@vitejs/plugin-vue": "6.0.1",
    "autoprefixer": "10.4.21",
    "concurrently": "^7.6.0",
    "electron": "^25.0.0",
    "postcss": "8.5.6",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "sass-embedded": "1.93.2",
